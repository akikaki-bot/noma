use "std/arr" as arr;
use "std/io" as io;
use "std/number" as number;

async fn first(values: Array<int32>) -> int32 {
    io.puts("Future started") catch e { return 1; };
    return values[0] + 0;
}

pub async fn main() -> int32 {
    let mut values: Array<int32> = [10, 20];
    arr.push<int32>(values, 30);
    let count: int32 = arr.length<int32>(read values);
    let pending: Future<int32> = first(snapshot values);
    arr.set<int32>(values, 0, 99) catch e { return 1; };
    io.puts("Created " + number.int32ToString(count) + " elements") catch e { return 1; };
    let answer: int32 = await pending;
    io.puts("Snapshot result: " + number.int32ToString(answer)) catch e { return 1; };
    return 0;
}
