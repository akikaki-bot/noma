use "std/io" as io;

type Box<T> = struct { value: T; };

fn identity<T>(value: T) -> T { return value; }
fn replace<T>(mut target: T, value: T) -> void { target = value; }

pub fn main() -> int32 {
	let mut count: int32 = 0;
	while count < 3 { count++; }
	let independent: int32 = identity<int32>(snapshot count);
	replace<int32>(count, independent);
	let box: Box<int32> = Box<int32> { value: snapshot count };
	if (box.value == 3) {
		io.puts(identity<string>("Generics v0.1")) catch error { return 1; };
		return 0;
	}
	return 1;
}
