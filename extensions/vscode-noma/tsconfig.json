{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"types": ["node", "vscode"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "test/host/**/*.ts"]
}
