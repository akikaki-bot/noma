{
	"comments": {
		"lineComment": "//",
		"blockComment": ["/*", "*/"]
	},
	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}", "notIn": ["string", "comment"] },
		{ "open": "[", "close": "]", "notIn": ["string", "comment"] },
		{ "open": "(", "close": ")", "notIn": ["string", "comment"] },
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
	],
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["\"", "\""]
	],
	"autoCloseBefore": ";:.,=}])| \n\t",
	"wordPattern": "[A-Za-z_][A-Za-z_0-9]*|[0-9]+",
	"indentationRules": {
		"increaseIndentPattern": "^(?:[^\"/]|\"(?:[^\"\\\\]|\\\\.)*\"|/(?![/*]))*(?:\\{[^}\"/]*|\\([^)\"/]*|\\[[^\\]\"/]*)\\s*(?://.*)?$",
		"decreaseIndentPattern": "^\\s*[}\\])]"
	}
}
