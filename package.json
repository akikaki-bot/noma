{
	"name": "noma",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"main": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./compiler": {
			"types": "./dist/src/compiler.d.ts",
			"import": "./dist/src/compiler.js"
		},
		"./analysis": {
			"types": "./dist/src/analysis.d.ts",
			"import": "./dist/src/analysis.js"
		},
		"./workspace": {
			"types": "./dist/src/workspace.d.ts",
			"import": "./dist/src/workspace.js"
		},
		"./source": {
			"types": "./dist/src/source.d.ts",
			"import": "./dist/src/source.js"
		}
	},
	"description": "Noma language prototype with explicit types and a trusted native bridge",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "npm run build && node --test dist/test/*.test.js",
		"start": "node dist/src/cli.js",
		"demo": "npm run build && node dist/src/cli.js examples/hello.noma",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" package.json tsconfig.json",
		"format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" package.json tsconfig.json",
		"extension:install": "npm --prefix extensions/vscode-noma ci",
		"extension:build": "npm --prefix extensions/vscode-noma run build",
		"extension:test": "npm --prefix extensions/vscode-noma test",
		"extension:test:host": "npm --prefix extensions/vscode-noma run test:host",
		"extension:package": "npm --prefix extensions/vscode-noma run package"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"prettier": "3.9.10",
		"typescript": "^5.9.0"
	}
}
